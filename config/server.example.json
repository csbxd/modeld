{
  "listen": "127.0.0.1:8765",
  "token_file": "/etc/modeld/api.token",
  "inference": {
    "model_file": "/usr/share/modeld/models/rife-4.26-heavy.onnx",
    "cache_directory": "/var/cache/modeld"
  },
  "limits": {
    "sessions": 2,
    "queued_segments": 8,
    "cached_segments": 12,
    "lease_seconds": 120,
    "source_timeout_seconds": 30
  },
  "output": {
    "segment_seconds": 2,
    "codec": "hevc",
    "qp": 18
  }
}
